# Database (used by backend and judge worker)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oj
POSTGRES_USER=oj
POSTGRES_PASSWORD=change_me
PG_SSLMODE=require

# Auth
JWT_SECRET=replace_with_long_random_string
JWT_EXPIRE_MINUTES=60

# Email verification links
VERIFY_BASE_URL=http://localhost:3000
DEV_ECHO_VERIFY_TOKEN=1

# SMTP for verification email (leave SMTP_HOST empty to disable)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="COTEA <no-reply@example.com>"
SMTP_STARTTLS=1
SMTP_TIMEOUT=10

# Frontend (oj-frontend/.env.local) – keep here as reference; copy to that file if needed
NEXT_PUBLIC_API_BASE=http://localhost:8000
